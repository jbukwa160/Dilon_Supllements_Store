# Install without running package install scripts.
# better-sqlite3 13 ships prebuilt binaries for Windows / Linux / macOS (node_modules/better-sqlite3/prebuilds), but
# npm 11 still runs `node-gyp rebuild` for it (the package contains a binding.gyp), which fails on machines without
# a C++ toolchain ("could not find Visual Studio"). No other dependency needs its install script: esbuild and
# unrs-resolver only verify their prebuilt platform packages, fsevents is macOS-only.
# `npm run <script>` (dev, build, start, import, admin:user) is not affected.
ignore-scripts=true
