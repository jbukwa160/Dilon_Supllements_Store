# Copy to .env.local and fill in. Everything is optional for local development.

# Public address of the shop (canonical URLs, sitemap, links in e-mails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Folder with catalog.db, store.db, uploads/ and outbox/ (default: ./data).
# Lets a second copy of the site (e.g. for testing) use its own data.
DATA_DIR=

# Speedy REST API. Needed for ANY Speedy delivery (office list, town search, prices): without it the two
# Speedy options are not offered at checkout at all.
SPEEDY_USERNAME=
SPEEDY_PASSWORD=

# Econt API. Econt's office and town lists are public, so Econt delivery always works; the login only adds live
# prices. Without it (or whenever a courier price can't be fetched) the fixed prices from Настройки → Доставка
# are charged. Office / town lists are cached in data/store.db (last good copy kept if the courier is down);
# if the town search is down, customers can type the town and post code for address delivery (fixed price).
ECONT_USERNAME=
ECONT_PASSWORD=

# Signs the "orders placed in this browser" cookie that unlocks the order confirmation page.
# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Empty = a random secret is generated once and kept in data/store.db.
ORDER_VIEW_SECRET=

# Outgoing e-mail (order confirmations, password reset). Empty SMTP_HOST = e-mails are written
# to data/outbox/*.eml instead of being sent (handy in development). With SMTP_HOST, a message the server
# refuses is kept in data/outbox/failed/ (.eml + .json) and sent again automatically; the admin dashboard
# shows how many are waiting.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender, e.g.: Dilon Nutrition <shop@example.bg>. Empty = the store name and e-mail from Настройки.
SMTP_FROM=

# Where new-order notifications go. Empty = the store e-mail from Настройки.
SHOP_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------------------------------------------------
# Server / deployment

# Which reverse proxy to believe for the visitor's IP address (rate limits, sign-in locks, sessions, chat, withdrawals).
#   empty      auto: 1 proxy when NEXT_PUBLIC_SITE_URL starts with https:// (nginx / Caddy / IIS in front), none otherwise
#   0          never trust X-Forwarded-For / X-Real-IP (the site is reached directly — every visitor shares one limit key)
#   1 … 5      that many proxies in front: the client is the Nth address from the right of X-Forwarded-For
#   x-real-ip  the proxy sets X-Real-IP (nginx: proxy_set_header X-Real-IP $remote_addr;)
# Keep the Node port (3000) reachable only from the proxy, or anyone could forge the header.
TRUST_PROXY=

# Token for POST /api/internal/revalidate (the price scheduler and `npm run import` use it to refresh cached pages).
# Empty = derived from the random secret in data/store.db, which works whenever the scripts run on the same machine
# with the same data folder. Set it (16+ random characters, the same value for the site and the scripts) otherwise.
REVALIDATE_SECRET=

# Address at which scripts on this machine reach the running site (`npm run import` → refresh the cached pages).
# Empty = http://localhost:$PORT (3000). Example for `next start -p 3950`: http://127.0.0.1:3950
SITE_INTERNAL_URL=

# 1 = do not start the background jobs (scheduled prices / promotions, mail retry, daily clean-up, courier lists) in
# this process. Set it on every EXTRA Node process when you run more than one copy of the site on the same data.
DISABLE_SCHEDULER=
